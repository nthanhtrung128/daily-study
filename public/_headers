# Header cho Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/).
# Lưu ý: nếu một header được đặt ở nhiều quy tắc cùng khớp, Cloudflare NỐI giá trị bằng dấu phẩy,
# nên Cache-Control chỉ đặt ở các quy tắc riêng bên dưới, không đặt ở "/*".
# `vite preview` (và test Playwright) cũng đọc file này qua scripts/cf-headers.ts.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob: data:; connect-src 'self' blob: data:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=(), usb=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noindex, nofollow, noarchive

# Asset do Vite build có hash trong tên → cache vĩnh viễn.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Các file quyết định phiên bản app → luôn hỏi lại máy chủ (có ETag nên vẫn nhanh).
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
