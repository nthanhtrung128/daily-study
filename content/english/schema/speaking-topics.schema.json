{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "speaking-topics.schema.json",
  "title": "Đề nói 1 phút (content/english/speaking-topics.json)",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/topicItem" }
    }
  },
  "$defs": {
    "topicItem": {
      "type": "object",
      "required": ["id", "en", "vi", "topic", "level", "hints"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^st-\\d{4}$" },
        "en": { "description": "Đề bài tiếng Anh.", "$ref": "common.schema.json#/$defs/en" },
        "vi": { "$ref": "common.schema.json#/$defs/vi" },
        "topic": { "$ref": "common.schema.json#/$defs/topic" },
        "level": { "$ref": "common.schema.json#/$defs/level" },
        "hints": {
          "description": "Ý chính gợi ý khi nói (bullet).",
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "$ref": "common.schema.json#/$defs/en" }
        },
        "useful": {
          "description": "Tùy chọn (thêm ở S7): từ / cụm nên dùng khi nói.",
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/en" }
        },
        "opener": { "description": "Tùy chọn (thêm ở S7): câu mở đầu mẫu.", "$ref": "common.schema.json#/$defs/en" },
        "seconds": { "description": "Thời gian nói (mặc định 60).", "type": "integer", "minimum": 30, "maximum": 180 },
        "trConcept": { "description": "Id khái niệm TR101 liên quan (đề giải thích khái niệm), phải có trong content/tr101/data.json.", "type": "string", "pattern": "^K\\d{3}$" }
      }
    }
  }
}
